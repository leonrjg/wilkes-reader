{
  "name": "@leonrjg/wilkes-reader",
  "version": "0.1.0",
  "description": "Document readers (PDF, Markdown, source) shared between Wilkes and Underdog.",
  "license": "MIT",
  "repository": "github:leonrjg/wilkes-reader",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/testing/setup.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/pdfjsAssets.d.ts",
      "default": "./dist/vite/pdfjsAssets.js"
    },
    "./testing": {
      "types": "./dist/testing/readerHarness.d.ts",
      "default": "./dist/testing/readerHarness.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "default": "./dist/testing/setup.js"
    },
    "./reader.css": "./dist/reader.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/*.css dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-go": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-java": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/state": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@codemirror/view": "^6",
    "@tanstack/react-virtual": "^3",
    "codemirror": "^6",
    "react-feather": "^2.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  }
}

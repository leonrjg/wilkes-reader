{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"],
  // The tests are not typechecked, matching how they lived in Wilkes.
  // Bringing them under tsc needs vitest and jest-dom type references
  // and a pass over what that surfaces; it is not done.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
